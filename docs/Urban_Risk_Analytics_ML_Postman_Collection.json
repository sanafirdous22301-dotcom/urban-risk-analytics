            "description": "Returns architecture, input features, dataset origin, and held-out validation metrics (MAE, RMSE, R²) for all active ML models."
          }
        },
        {
          "name": "Predict Heat Risk (POST /api/ml/predict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 17.3850,\n  \"longitude\": 78.4867,\n  \"nighttime_temp_c\": 24.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ml/predict",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ml", "predict"]
            },
            "description": "Predicts daytime surface temperature, diurnal difference, and heat risk band using trained Random Forest Regressor."
          }
        },
        {
          "name": "Predict Heat Risk - Root Alias (POST /predict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 17.4375,\n  \"longitude\": 78.4482,\n  \"nighttime_temp_c\": 28.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/predict",
              "host": ["{{baseUrl}}"],
              "path": ["predict"]
            },
            "description": "Compatibility endpoint on root /predict path."
          }
        },
        {
          "name": "Predict Daytime UHI Anomaly (POST /api/ml/predict/uhi)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 17.3850,\n  \"longitude\": 78.4867,\n  \"nighttime_uhi\": 1.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ml/predict/uhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ml", "predict", "uhi"]
            },
            "description": "Predicts Urban Heat Island anomaly using the Yale model."
          }
        },
        {
          "name": "ML Validation Error Test (Out of bounds latitude)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 250.0,\n  \"longitude\": 78.4867,\n  \"nighttime_temp_c\": 24.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ml/predict",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ml", "predict"]
            },
            "description": "Negative test case: verifies HTTP 422 Unprocessable Entity when latitude exceeds 90."
          }
        },
        {
          "name": "ML Validation Error Test (Missing required field)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 17.3850,\n  \"longitude\": 78.4867\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ml/predict",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ml", "predict"]
            },
            "description": "Negative test case: verifies HTTP 422 Unprocessable Entity when nighttime_temp_c is missing."
          }
        }
      ]
    },
